# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.

# --- Resend (formulario de contacto) ---
# Solo se leen en el servidor (app/acerca-de/actions.ts).

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Buzón del equipo que recibe los mensajes del formulario de contacto.
# Con el remitente de pruebas (abajo) tiene que ser el correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente en un dominio verificado en Resend, p. ej. "Arcade Vault <contacto@tu-dominio>".
# Sin dominio verificado (solo pruebas): "Arcade Vault <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

# --- Supabase ---
# Públicas por diseño (llevan NEXT_PUBLIC_): llegan al navegador. Solo las lee lib/supabase/env.ts.
# Valores en el dashboard de Supabase → Project Settings → API.

# URL del proyecto, p. ej. https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Nunca pongas aquí la secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
