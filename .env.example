# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.
# Las tres variables solo se leen en el servidor (app/acerca-de/actions.ts).

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Buzón del equipo que recibe los mensajes del formulario de contacto.
# Con el remitente de pruebas (abajo) tiene que ser el correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente en un dominio verificado en Resend, p. ej. "Arcade Vault <contacto@tu-dominio>".
# Sin dominio verificado (solo pruebas): "Arcade Vault <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=

SUPABASE_DB_PASSWORD=XXXXXXXX
NEXT_PUBLIC_SUPABASE_URL=XXXXXXXXX
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=XXXXXXXXX