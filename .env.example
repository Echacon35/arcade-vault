# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.
# Las tres variables solo se leen en el servidor (app/acerca-de/actions.ts).

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Buzón del equipo que recibe los mensajes del formulario de contacto
CONTACT_TO_EMAIL=

# Remitente en el dominio verificado en Resend, p. ej. "Arcade Vault <contacto@tu-dominio>"
CONTACT_FROM_EMAIL=
